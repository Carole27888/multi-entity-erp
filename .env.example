# Environment settings. Copy to .env and edit. Never commit .env.
# Process environment variables take precedence over this file.
# Everything has a working default for local development: you can run without a .env file.

# --- Product & platform ----------------------------------------------------------------
PRODUCT_NAME=Pamoja
PRODUCT_TAGLINE=Your whole business, together
# Your domain. The staff app lives at APP_HOST; tenants at https://APP_HOST/<org-slug>/
PLATFORM_DOMAIN=domain.co.ke
APP_HOST=app.domain.co.ke
# Other host names that also serve the staff app (local development).
APP_HOST_ALIASES=localhost,127.0.0.1
# Public sites: https://APP_HOST/s/<org-slug>/ always works. With WILDCARD_SUBDOMAINS=True they are also served at
# https://<org-slug>.PUBLIC_DOMAIN/ (Growth plan and up). Turn it on only after the host has given you a wildcard
# DNS record (*.domain.co.ke) AND a wildcard TLS certificate. Custom domains work either way.
PUBLIC_DOMAIN=domain.co.ke
WILDCARD_SUBDOMAINS=False
# path = staff app at APP_HOST/<org-slug>/ (default) · subdomain = staff app at <org-slug>.APP_HOST (needs wildcard TLS)
TENANT_ROUTING=path
SUPPORT_EMAIL=support@domain.co.ke
# Platform brand colour (PWA icons, sign-in pages). Each organization sets its own in Settings.
BRAND_COLOUR=#4F46E5

# The platform company, which bills tenants (placeholders until the real details are given).
PLATFORM_LEGAL_NAME=[PLATFORM LEGAL NAME] Ltd
PLATFORM_KRA_PIN=P000000000X
PLATFORM_VAT_REGISTERED=False
PLATFORM_PAYBILL=000000
PLATFORM_ADDRESS=Nairobi, Kenya

# --- Core -------------------------------------------------------------------------------
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# True only on your own computer. Production settings force DEBUG off.
DEBUG=True
# Full origins (with https://) allowed to POST forms, e.g. https://app.domain.co.ke
CSRF_TRUSTED_ORIGINS=
# Public address of the staff app (links in emails, QR codes).
SITE_URL=http://localhost:8000
# Error emails, as "Name:email" pairs separated by commas.
ADMINS=

# --- Database -----------------------------------------------------------------------------
# Leave DATABASE_URL unset to use SQLite at ./db.sqlite3 (no setup needed).
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://platform:password@localhost:5432/platform
# DATABASE_URL=mysql://platform:password@localhost:3306/platform
# MySQL: pip install -r requirements-mysql.txt. Set DB_MYSQL_DRIVER=pymysql if mysqlclient can't be built.
# DB_MYSQL_DRIVER=pymysql
# DB_OPTIONS={"charset":"utf8mb4","init_command":"SET sql_mode='STRICT_TRANS_TABLES'"}
# Seconds to keep connections open (0 = close after each request).
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# --- Background jobs -----------------------------------------------------------------------
# sync = run jobs inline (development). cron = queue for `manage.py run_jobs` every 5 minutes (production).
JOBS_BACKEND=sync
# Maximum seconds one run_jobs invocation works before exiting.
JOBS_RUN_TIME_LIMIT=240

# --- Cache & email -------------------------------------------------------------------------
# Default (no setting needed): dbcache://platform_cache  (shared database cache, table made by migrate)
# CACHE_URL=filecache:///home/USER/APP/tmp/cache
# CACHE_URL=rediscache://127.0.0.1:6379/1
# EMAIL_URL=consolemail://
# EMAIL_URL=smtp+tls://user@example.com:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=Pamoja <no-reply@domain.co.ke>

# --- Files & logs ----------------------------------------------------------------------------
# Keep MEDIA_ROOT OUTSIDE public_html: uploaded files are only served by permission-checked views.
# STATIC_ROOT=/home/USER/APP/staticfiles
# MEDIA_ROOT=/home/USER/APP_media
# LOG_DIR=/home/USER/APP/logs
FILE_UPLOAD_MAX_MB=10
# Let Apache stream permission-checked downloads (only if mod_xsendfile is enabled on the host).
USE_X_SENDFILE=False

# --- Security (production) -------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
# "Keep me signed in" length in seconds (default 30 days). Roles that handle money are shorter (see Roles).
SESSION_COOKIE_AGE=2592000
# Failed logins allowed per 15 minutes per IP + email.
LOGIN_RATE_LIMIT=5
# Sign-ups allowed per hour per IP.
SIGNUP_RATE_LIMIT=5
# Encrypts TOTP secrets, stored credentials and confidential fields (defaults to SECRET_KEY).
# Changing it makes stored secrets unreadable. Keep a copy off the server.
FIELD_ENCRYPTION_KEY=

# --- Two-factor login ------------------------------------------------------------------------
# Owner, Admin and Finance roles (and custom roles marked "two-factor required") must use an authenticator app.
# Set False only for a local demo; anyone who turned it on for themselves is still asked for a code.
TWO_FACTOR_ENFORCED=True
# Name shown in the authenticator app.
TWO_FACTOR_ISSUER=Pamoja

# --- Trial & plans -----------------------------------------------------------------------------
TRIAL_DAYS=14
# A trial gets this plan's features (plans and limits are edited in /django-admin/ › Plans).
TRIAL_PLAN=growth

# --- Installable app (PWA) ----------------------------------------------------------------------
# Bumped automatically by deploy.sh so installed apps fetch the new version.
PWA_VERSION=1

# --- Integrations (mock implementations are used while these are empty) -------------------------
# SMS: mock (default; nothing is sent) or africastalking. Phone verification at sign-up switches on with a real provider.
SMS_PROVIDER=mock
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Monitoring -----------------------------------------------------------------------------------
# Server errors are emailed to ADMINS above (needs EMAIL_URL). Optionally also report them to Sentry:
# SENTRY_DSN=https://<key>@o000000.ingest.sentry.io/0000000
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# Uptime: point UptimeRobot / Better Stack at https://APP_HOST/health/  (200 = healthy, 503 = problem)
